{$BORMOCLASS_DOMAIN:localhost} {
    encode zstd gzip

    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
    }

    handle_path /static/* {
        root * /srv/bormoclass/app/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    @sse_streams path /api/classroom/*/stream /api/board/*/stream
    handle @sse_streams {
        reverse_proxy bormoclass:8010 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy bormoclass:8010
    }
}
